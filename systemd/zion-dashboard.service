[Unit]
Description=ZION Read-Only Local Dashboard
After=zion.service
Wants=zion.service

[Service]
Type=simple
User=zetta
WorkingDirectory=/home/zetta/zion-community-bot

# Deliberately do NOT load the bot .env here.
# Dashboard receives only non-secret runtime locations.
Environment=ZION_DASHBOARD_ROOT=/home/zetta/zion-community-bot
Environment=ZION_DASHBOARD_DB_PATH=/home/zetta/zion-community-bot/zion.db
Environment=ZION_DASHBOARD_WIFI_INTERFACE=wlx78bdbc575d1c
Environment=ZION_DASHBOARD_BIND=127.0.0.1
Environment=ZION_DASHBOARD_PORT=8765

ExecStart=/home/zetta/zion-community-bot/.venv/bin/python -m zion.admin_dashboard
Restart=on-failure
RestartSec=10

UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
