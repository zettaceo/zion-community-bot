[Unit]
Description=ZION Community Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=zetta
WorkingDirectory=/home/zetta/zion-community-bot
EnvironmentFile=/home/zetta/zion-community-bot/.env

# O network-online.target nem sempre significa que DNS já responde.
# Mantemos o serviço em "activating" até api.telegram.org resolver,
# evitando ciclos de crash/restart durante o boot.
ExecStartPre=/bin/sh -c 'until /usr/bin/getent hosts api.telegram.org >/dev/null 2>&1; do echo "ZION aguardando rede/DNS para api.telegram.org..."; sleep 5; done'

ExecStart=/usr/bin/env ZION_DB_PATH=/home/zetta/.local/state/zion-community-bot/zion.db ZION_STATE_FILE=/home/zetta/.local/state/zion-community-bot/zion_state.json ZION_LOG_PATH=/home/zetta/.local/state/zion-community-bot/zion.log ZION_RUNTIME_LOCK_PATH=/home/zetta/.local/state/zion-community-bot/runtime.lock /home/zetta/.local/share/zion-community-bot/runtimes/current/bin/python /home/zetta/zion-community-bot/bot.py

Restart=always
RestartSec=10
# ExecStartPre pode aguardar DNS por tempo indefinido durante boot/offline.
TimeoutStartSec=0
TimeoutStopSec=20

# Arquivos criados pelo processo ficam privados por padrão.
UMask=0077
NoNewPrivileges=true

# Sandbox de processo. Código, .env e runtime Python permanecem
# somente leitura; somente o state dir contém estado mutável do bot.
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/home/zetta/zion-community-bot
ReadOnlyPaths=/home/zetta/.local/share/zion-community-bot/runtimes
ReadWritePaths=/home/zetta/.local/state/zion-community-bot

[Install]
WantedBy=multi-user.target
