[Unit]
Description=ZION Read-Only Local Dashboard
After=zion.service
Wants=zion.service

[Service]
Type=simple
User=zetta
WorkingDirectory=/home/zetta/zion-community-bot

# Deliberately do NOT load the bot .env here.
# Dashboard receives only non-secret runtime locations.
Environment=ZION_DASHBOARD_ROOT=/home/zetta/zion-community-bot
Environment=ZION_DASHBOARD_DB_PATH=/home/zetta/.local/state/zion-community-bot/zion.db
Environment=ZION_DASHBOARD_WIFI_INTERFACE=wlx78bdbc575d1c
Environment=ZION_DASHBOARD_BIND=127.0.0.1
Environment=ZION_DASHBOARD_PORT=8765
Environment=ZION_DASHBOARD_LOG_PATH=/home/zetta/.local/state/zion-community-bot/dashboard/zion-dashboard.log

ExecStart=/home/zetta/.local/share/zion-community-bot/runtimes/current/bin/python -m zion.admin_dashboard
Restart=on-failure
RestartSec=10

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/home/zetta/zion-community-bot
ReadOnlyPaths=/home/zetta/.local/share/zion-community-bot/runtimes
ReadOnlyPaths=/home/zetta/.local/state/zion-community-bot
InaccessiblePaths=/home/zetta/.local/share/zion-community-bot/deploy-backups
ReadWritePaths=/home/zetta/.local/state/zion-community-bot/dashboard

[Install]
WantedBy=multi-user.target
