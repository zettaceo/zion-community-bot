[Unit]
Description=ZION SSH ingress guard (Tailscale only)
Documentation=file:/home/zetta/zion-community-bot/docs/REMOTE-ACCESS.md
Wants=tailscaled.service
After=nftables.service tailscaled.service
Before=ssh.service sshd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/zion-ssh-firewall-runtime apply
ExecStop=/usr/local/sbin/zion-ssh-firewall-runtime remove

[Install]
WantedBy=multi-user.target
