# ZION — example only. Never commit real credentials.

# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to run admin commands
# even in private chat. Group admins are also recognized inside groups.
ZION_ADMIN_USER_IDS=

# Deterministic moderation
ALLOW_LINKS=false
ALLOWED_DOMAINS=
FLOOD_MAX_MESSAGES=6
FLOOD_WINDOW_SECONDS=10
FLOOD_PURGE_WINDOW_SECONDS=300
FLOOD_MUTE_LEVELS=60,300,900,3600
FLOOD_STRIKE_RESET_SECONDS=3600
FLOOD_BAN_AFTER_STRIKES=4
ADMIN_CACHE_SECONDS=60

# Local persistence
ZION_DB_PATH=/home/zetta/zion-community-bot/zion.db
ZION_STATE_FILE=/home/zetta/zion-community-bot/zion_state.json
ZION_KNOWLEDGE_DIR=/home/zetta/zion-community-bot/knowledge
ZION_LOG_PATH=/home/zetta/zion-community-bot/zion.log
ZION_REPORT_RETENTION_DAYS=90
ZION_REPORT_REQUESTS_PER_MINUTE=3
ZION_AMA_REQUESTS_PER_MINUTE=5
ZION_USER_EVENT_RETENTION_DAYS=30
ZION_KNOWLEDGE_GAP_RETENTION_DAYS=30
ZION_WIFI_INTERFACE=wlx78bdbc575d1c

# Raid / mass-join detection
ZION_RAID_MAX_JOINS=8
ZION_RAID_WINDOW_SECONDS=60
ZION_RAID_ELEVATED_SECONDS=900

# Distributed chat-burst detection. This only raises temporary ELEVATED
# mode; it does not punish individual users by itself.
ZION_CHAT_BURST_MAX_MESSAGES=45
ZION_CHAT_BURST_WINDOW_SECONDS=15
ZION_CHAT_BURST_MIN_USERS=6
ZION_CHAT_BURST_ELEVATED_SECONDS=600

# Operational warning thresholds
ZION_DISK_WARN_MB=2048
ZION_UPDATE_LAG_WARN_SECONDS=120
# Repeat an unchanged operational alert at most every 6 hours.
ZION_HEALTH_ALERT_REPEAT_SECONDS=21600

# Delivery reliability for scheduled and recurring community messages
ZION_SCHEDULE_MAX_ATTEMPTS=5
ZION_SCHEDULE_RETRY_SECONDS=60
ZION_RECURRING_MAX_FAILURES=10

ZION_AMA_RETENTION_DAYS=30

# Mistral AI
# AI stays off until explicitly enabled and a key is present.
MISTRAL_API_KEY=
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_SECONDS=30
MISTRAL_MAX_TOKENS=700

ZION_AI_ENABLED=false
# Observe-only classification never deletes, mutes or bans.
ZION_AI_OBSERVE=false
ZION_AI_MIN_OBSERVE_CHARS=16
ZION_AI_REQUESTS_PER_MINUTE=4
ZION_AI_MAX_CONCURRENCY=2
# Combined prompt + completion tokens per UTC day. 0 = unlimited.
ZION_AI_DAILY_TOKEN_BUDGET=50000
ZION_AI_CIRCUIT_FAILURES=3
ZION_AI_CIRCUIT_SECONDS=120

# Optional read-only local operations dashboard
ZION_DASHBOARD_BIND=127.0.0.1
ZION_DASHBOARD_PORT=8765
